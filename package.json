{
  "name": "murder-sudoku",
  "version": "1.0.0",
  "private": true,
  "description": "Murder Sudoku: free murder-mystery logic puzzles in your browser, in 3D and printable.",
  "homepage": "https://jeroenmarchand.github.io/murder-sudoku/",
  "repository": "github:jeroenmarchand/murder-sudoku",
  "license": "PolyForm-Noncommercial-1.0.0",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/dev.mjs",
    "test": "npm run build && node --test tests/core.test.mjs && node tests/smoke.mjs && node tests/e2e.mjs",
    "test:core": "node --test tests/core.test.mjs",
    "test:smoke": "npm run build && node tests/smoke.mjs",
    "test:e2e": "npm run build && node tests/e2e.mjs",
    "screenshots": "npm run build && node scripts/screenshots.mjs"
  },
  "devDependencies": {
    "playwright": "^1.48.0"
  },
  "engines": {
    "node": ">=20"
  }
}
